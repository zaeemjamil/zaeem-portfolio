# Copy this file to .env for local use (e.g. `vercel dev`), or add these in Vercel > Project > Settings > Environment Variables.
# NEVER put a real key in index.html, data.js, or any file that is committed to GitHub. Placeholders only below.
OPENROUTER_API_KEY=
# Optional. Leave empty to use the default free router (openrouter/free). Set a model id only if you want to pin one.
OPENROUTER_MODEL=openrouter/free
